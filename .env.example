# OpenWeather API Key for live weather and 5-day forecasts
# Get a free key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# The assistant ("Ask AI" in the tool bar, and the buttons in the fertilization
# and soil modules). All three are read on the server and never reach the
# browser; leave them unset and the assistant reports that it is not configured
# rather than failing. Provider is one of: anthropic, openai, gemini.
# The model is named here rather than defaulted in the source because model
# names move faster than releases — e.g. claude-opus-5 for anthropic.
# FIELDMANAGER_AI_PROVIDER=anthropic
# FIELDMANAGER_AI_API_KEY=your_provider_api_key_here
# FIELDMANAGER_AI_MODEL=claude-opus-5

# Where the app stores field data (fields, groups, soil analyses, irrigation,
# fertilization and crop protection records). Defaults to ./data next to the
# project, which is created on first save. Point it somewhere outside the
# project — /var/lib/... — if you want the data to survive redeploying into a
# fresh checkout.
# FIELDMANAGER_DATA_DIR=/var/lib/fieldmanager

# Password for the "admin" account, used only when the account file is created
# on the very first start. Without it the app seeds the documented default
# password "admin" and asks for a new one at every sign-in until it is changed.
# Once accounts exist this is ignored, so it never resets a password you set.
# FIELDMANAGER_ADMIN_PASSWORD=choose-something-long

# Port for production deployment (default: 3000).
# Next.js reads PORT from the real environment, not from this file. Set it in
# your shell (PORT=8080 bun run start) or in the systemd unit — see README.md.
PORT=3000
