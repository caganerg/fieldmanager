# OpenWeather API Key for live weather and 5-day forecasts
# Get a free key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Where the app stores field data (fields, groups, soil analyses, irrigation
# and fertilization records). Defaults to ./data next to the project, which is
# created on first save. Point it somewhere outside the project — /var/lib/... —
# if you want the data to survive redeploying into a fresh checkout.
# FIELDMANAGER_DATA_DIR=/var/lib/fieldmanager

# Port for production deployment (default: 3000).
# Next.js reads PORT from the real environment, not from this file. Set it in
# your shell (PORT=8080 bun run start) or in the systemd unit — see README.md.
PORT=3000
