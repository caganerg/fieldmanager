# OpenWeather API Key for live weather and 5-day forecasts
# Get a free key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Port for production deployment (default: 3000).
# Next.js reads PORT from the real environment, not from this file — install.sh
# picks it up from your shell and writes it into the systemd unit:
#   PORT=8080 ./install.sh
PORT=3000
